{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:4173"
      ],
      "startServerCommand": "pnpm run build && pnpm run preview",
      "numberOfRuns": 1
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.95
          }
        ]
      }
    }
  }
}