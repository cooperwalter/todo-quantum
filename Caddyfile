{
	admin off
	persist_config off
	auto_https off
	servers {
		trusted_proxies static private_ranges
	}
}

:{$PORT:8080} {
	root * /srv
	encode zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'"
	}

	# Kept out of the block above: a delete op defers the whole block, and
	# deferred ops are skipped on Caddy's error path, which would strip the
	# security headers from every 404.
	header -Server

	handle /api/* {
		reverse_proxy 127.0.0.1:3000
	}

	# No try_files here: a missing asset must 404 rather than fall back to the
	# shell, which would otherwise be served under the immutable header below.
	# The file guard keys the year-long TTL on the served file rather than the
	# request path, so a rollover 404 is never pinned.
	handle /assets/* {
		@exists file
		header @exists Cache-Control "public, max-age=31536000, immutable"
		@missing not file
		header @missing Cache-Control "no-cache"
		file_server
	}

	# The shell, served for any unmatched deep link, must always revalidate or
	# clients pin to a stale asset manifest.
	handle {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
